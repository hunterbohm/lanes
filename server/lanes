"""


class PullRequestPoller:
    """Background GitHub GraphQL poller for open PRs + SSRF-safe media proxy for private proof videos/images."""

    def __init__(self, config: dict) -> None:
        self.owners = [str(o).strip() for o in config.get("owners") or [] if isinstance(o, str) and o.strip()]
        self.exclude_repos = [str(p).strip().lower() for p in config.get("exclude_repos") or [] if isinstance(p, str) and p.strip()]
        self.refresh_s = max(15, int(config.get("refresh_s") or PR_REFRESH_DEFAULT_S))
        self.max_prs = max(1, min(200, int(config.get("max_prs") or 120)))
        self.page_size = max(10, min(50, int(config.get("page_size") or 40)))
        self.token_command = str(config.get("token_command") or "gh auth token")
        self.token_env = str(config.get("token_env") or "GITHUB_TOKEN")
        self._token = ""
        self._token_at = 0.0
        self._token_lock = threading.Lock()
        self._kind_cache: dict[str, str] = {}
        self._owner_cache: dict[str, list[dict]] = {}
        self.summary: dict | None = (
            {"open": 0, "repos": 0, "with_proof": 0, "failing": 0, "merge_ready": 0, "updated": int(time.time()), "error": None}
            if self.owners else None
        )
        self.body = json.dumps({
            "configured": bool(self.owners), "ok": True, "error": None, "updated": int(time.time()),
            "owners": self.owners, "total": 0, "repos": [], "prs": [],
        }).encode()

    def get_token(self, force: bool = False) -> str:
        with self._token_lock:
            now = time.time()
            if not force and self._token and now - self._token_at < 600:
                return self._token
            tok = os.environ.get(self.token_env, "").strip()
            if not tok and self.token_command:
                try:
                    out = subprocess.run(shlex.split(self.token_command), capture_output=True, text=True, timeout=10).stdout
                    tok = out.strip()
                except (OSError, subprocess.SubprocessError):
                    tok = ""
            if tok:
                self._token = tok
                self._token_at = now
            return self._token

    def open_media_upstream(self, url: str, range_header: str | None = None, head: bool = False):
        """Fetch an allowlisted GitHub media URL, following redirects without leaking auth to S3/CDN hosts."""
        norm = is_allowed_media_url(url, self.owners)
        if not norm:
            return 403, {"Content-Type": "text/plain"}, None
        token = self.get_token()
        cur = norm
        safe_range = range_header.strip() if range_header and RANGE_HEADER_RE.match(range_header.strip()) else None
        for _ in range(6):
            parsed = urllib.parse.urlsplit(cur)
            host = (parsed.hostname or "").lower()
            if parsed.scheme.lower() != "https" or parsed.port not in (None, 443) or not is_allowed_redirect_host(host):
                return 403, {"Content-Type": "text/plain"}, None
            headers = {"User-Agent": f"lanes/{VERSION}"}
            if token and host in GITHUB_AUTH_HOSTS:
                headers["Authorization"] = f"Bearer {token}"
            if safe_range:
                headers["Range"] = safe_range
            req = urllib.request.Request(cur, headers=headers, method="HEAD" if head else "GET")
            try:
                resp = _NO_REDIRECT_OPENER.open(req, timeout=15)
                return resp.status, dict(resp.headers.items()), resp
            except urllib.error.HTTPError as err:
                loc = err.headers.get("Location") if err.headers else None
                if err.code in (301, 302, 303, 307, 308) and loc:
                    cur = urllib.parse.urljoin(cur, loc)
                    err.close()
                    continue
                code = err.code
                err.close()
                return code, {"Content-Type": "text/plain"}, None
            except OSError:
                return 502, {"Content-Type": "text/plain"}, None
        return 502, {"Content-Type": "text/plain"}, None

    def probe_media_kind(self, norm_url: str) -> str:
        cached = self._kind_cache.get(norm_url)
        if cached:
            return cached
        status, headers, resp = self.open_media_upstream(norm_url, range_header="bytes=0-0")
        if resp is not None:
            resp.close()
        ct = ""
        for k, v in headers.items():
            if k.lower() == "content-type":
                ct = v.lower()
                break
        if status in (200, 206):
            kind = "image" if ct.startswith("image/") else "video"
            self._kind_cache[norm_url] = kind
            return kind
        return "video"

    def _query_owner_page(self, owner: str, limit: int, token: str, after: str | None = None) -> tuple[list[dict], str | None]:
        q = f"is:pr is:open user:{owner} sort:updated-desc"
        payload = json.dumps({"query": PR_GRAPHQL_QUERY, "variables": {"q": q, "first": limit, "after": after}}).encode()
        req = urllib.request.Request(
            "https://api.github.com/graphql",
            data=payload,
            headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json", "User-Agent": f"lanes/{VERSION}"},
        )
        with urllib.request.urlopen(req, timeout=20) as resp:
            data = json.loads(resp.read().decode("utf-8", "replace"))
        search = (data.get("data") or {}).get("search") or {}
        nodes = [n for n in (search.get("nodes") or [])
                 if isinstance(n, dict) and n.get("number") and (n.get("repository") or {}).get("nameWithOwner")]
        page_info = search.get("pageInfo") or {}
        next_cursor = page_info.get("endCursor") if page_info.get("hasNextPage") else None
        return nodes, next_cursor

    def _query_owner(self, owner: str, limit: int, token: str) -> list[dict]:
        """Fetch open PRs for one owner in small GraphQL pages so GitHub never 502s on node complexity."""
        out: list[dict] = []
        cursor: str | None = None
        while len(out) < limit:
            batch = min(self.page_size, limit - len(out))
            nodes, cursor = self._query_owner_page(owner, batch, token, after=cursor)
            out.extend(nodes)
            if not cursor or not nodes:
                break
        return out

    def normalize_pr(self, node: dict) -> dict:
        repo = node["repository"]["nameWithOwner"]
        number = int(node["number"])
        author = ((node.get("author") or {}).get("login")) or "unknown"
        is_bot = author.lower().endswith("[bot]") or author.lower() in ("dependabot", "renovate", "github-actions")
        head_ref = str(node.get("headRefName") or "")
        is_release = head_ref.startswith(("merge-train/", "release/", "hotfix/"))
        body = str(node.get("body") or "")
        comments = ((node.get("comments") or {}).get("nodes")) or []
        summary, why = extract_pr_summary(body)
        media = extract_pr_media(body, comments, self.owners, probe_kind=self.probe_media_kind)
        commits = ((node.get("commits") or {}).get("nodes")) or []
        rollup = ((commits[0].get("commit") or {}).get("statusCheckRollup")) if commits and isinstance(commits[0], dict) else None
        ci = summarize_ci_checks(rollup)
        review_decision = str(node.get("reviewDecision") or "")
        mergeable = str(node.get("mergeable") or "")
        is_draft = bool(node.get("isDraft"))
        merge_ready = (
            not is_draft
            and ci["state"] == "passing"
            and mergeable != "CONFLICTING"
            and review_decision in ("", "APPROVED")
        )
        files = [
            {"path": str(f.get("path") or ""), "additions": int(f.get("additions") or 0), "deletions": int(f.get("deletions") or 0)}
            for f in ((node.get("files") or {}).get("nodes")) or [] if isinstance(f, dict) and f.get("path")
        ]
        return {
            "id": f"{repo}#{number}",
            "repo": repo,
            "number": number,
            "title": str(node.get("title") or ""),
            "url": web_url(node.get("url")),
            "author": author,
            "is_bot": is_bot,
            "is_draft": is_draft,
            "is_release": is_release,
            "head_ref": head_ref,
            "base_ref": str(node.get("baseRefName") or "main"),
            "created_at": iso_ts(node.get("createdAt")),
            "updated_at": iso_ts(node.get("updatedAt")),
            "additions": int(node.get("additions") or 0),
            "deletions": int(node.get("deletions") or 0),
            "changed_files": int(node.get("changedFiles") or len(files)),
            "files": files,
            "summary": summary,
            "why": why,
            "review_decision": review_decision,
            "mergeable": mergeable,
            "merge_ready": merge_ready,
            "ci": ci,
            "media": media,
            "has_proof": bool(media),
            "has_video": any(m["kind"] == "video" for m in media),
        }

    def _is_excluded_repo(self, repo: str) -> bool:
        low = repo.lower()
        short = low.split("/", 1)[-1]
        return any(fnmatch.fnmatch(low, pat) or fnmatch.fnmatch(short, pat) for pat in self.exclude_repos)

    def refresh(self) -> None:
        if not self.owners:
            return
        now = int(time.time())
        token = self.get_token()
        if not token:
            err = "GitHub token unavailable (check `gh auth status` or `token_env`)"
            self.summary = {"open": 0, "repos": 0, "with_proof": 0, "failing": 0, "merge_ready": 0, "updated": now, "error": err}
            self.body = json.dumps({"configured": True, "ok": False, "error": err, "updated": now,
                                    "owners": self.owners, "total": 0, "repos": [], "prs": []}).encode()
            return
        per_owner = min(120, max(40, self.max_prs))
        seen: dict[str, dict] = {}
        errors = []
        for owner in self.owners:
            try:
                nodes = self._query_owner(owner, per_owner, token)
                self._owner_cache[owner] = [
                    self.normalize_pr(node) for node in nodes
                    if not self._is_excluded_repo(node["repository"]["nameWithOwner"])
                ]
            except urllib.error.HTTPError as err:
                if err.code == 401:
                    token = self.get_token(force=True)
                errors.append(f"{owner}: HTTP {err.code}")
                print(f"pr refresh {owner} failed: HTTP {err.code}", file=sys.stderr, flush=True)
            except Exception as err:
                errors.append(f"{owner}: {type(err).__name__}")
                print(f"pr refresh {owner} failed: {err!r}", file=sys.stderr, flush=True)
            for pr in self._owner_cache.get(owner, []):
                seen[pr["id"]] = pr
        prs = sorted(seen.values(), key=lambda p: (p.get("updated_at") or 0, p["number"]), reverse=True)[:self.max_prs]
        by_repo: dict[str, dict] = {}
        for pr in prs:
            r = by_repo.setdefault(pr["repo"], {"name": pr["repo"], "count": 0, "with_proof": 0, "failing": 0, "merge_ready": 0})
            r["count"] += 1
            if pr["has_proof"]:
                r["with_proof"] += 1
            if pr["ci"]["state"] == "failing":
                r["failing"] += 1
            if pr["merge_ready"]:
                r["merge_ready"] += 1
        repos = sorted(by_repo.values(), key=lambda r: (-r["count"], r["name"].lower()))
        err_msg = "; ".join(errors) if errors and not prs else None
        self.summary = {
            "open": len(prs),
            "repos": len(repos),
            "with_proof": sum(1 for p in prs if p["has_proof"]),
            "failing": sum(1 for p in prs if p["ci"]["state"] == "failing"),
            "merge_ready": sum(1 for p in prs if p["merge_ready"]),
            "updated": now,
            "error": err_msg,
        }
        self.body = json.dumps({
            "configured": True,
            "ok": err_msg is None,
            "error": err_msg,
            "updated": now,
            "owners": self.owners,
            "total": len(prs),
            "repos": repos,
            "prs": prs,
        }).encode()

    def loop(self) -> None:
        while True:
            try:
                self.refresh()
            except Exception as error:
                print(f"pr refresh failed: {error!r}", file=sys.stderr, flush=True)
            time.sleep(self.refresh_s)


