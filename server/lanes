    def demo_media(query: dict, range_header: str | None, head: bool):
        import io, struct, zlib
        # Tiny 160x90 solid dark-slate PNG with a bright green check bar so `lanes demo` shows a real image.
        w, h = 160, 90
        rows = []
        for y in range(h):
            row = bytearray([0])
            for x in range(w):
                if 36 <= y <= 54 and 24 <= x <= 136:
                    row.extend((63, 207, 142))
                elif 12 <= y <= 22 and 24 <= x <= 96:
                    row.extend((90, 156, 255))
                else:
                    row.extend((28, 30, 38))
            rows.append(bytes(row))
        def chunk(tag: bytes, payload: bytes) -> bytes:
            return struct.pack(">I", len(payload)) + tag + payload + struct.pack(">I", zlib.crc32(tag + payload) & 0xFFFFFFFF)
        png = (b"\x89PNG\r\n\x1a\n"
               + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
               + chunk(b"IDAT", zlib.compress(b"".join(rows)))
               + chunk(b"IEND", b""))
        return 200, {"Content-Type": "image/png", "Content-Length": str(len(png))}, io.BytesIO(png)

