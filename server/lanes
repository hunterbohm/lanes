class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


_NO_REDIRECT_OPENER = urllib.request.build_opener(_NoRedirect)


def read_env_file(path: Path) -> dict[str, str]:
    """Parse KEY=VALUE lines from an env file (ignoring comments and blank lines)."""
    values: dict[str, str] = {}
    try:
        text = path.expanduser().read_text(encoding="utf-8", errors="replace")
    except OSError:
        return values
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        if line.startswith("export "):
            line = line[7:].strip()
        key, val = line.split("=", 1)
        key = key.strip()
        val = val.strip()
        if len(val) >= 2 and val[0] == val[-1] and val[0] in ("'", '"'):
            val = val[1:-1]
        if key:
            values[key] = val
    return values


def normalize_queue_url(url: str) -> str:
    """Turn ws(s)://.../listen or https://.../ into an HTTP(S) base URL."""
    raw = (url or "").strip()
    if not raw:
        return ""
    parsed = urllib.parse.urlsplit(raw)
    scheme = {"wss": "https", "ws": "http"}.get(parsed.scheme.lower(), parsed.scheme.lower())
    if scheme not in ("http", "https") or not parsed.netloc:
        return ""
    path = parsed.path.rstrip("/")
    if path.endswith("/listen"):
        path = path[:-7]
    return urllib.parse.urlunsplit((scheme, parsed.netloc, path, "", ""))


def iso_ts(text: str | None) -> int | None:
    if not isinstance(text, str) or len(text) < 19:
        return None
    try:
        return calendar.timegm(time.strptime(text[:19], "%Y-%m-%dT%H:%M:%S"))
    except ValueError:
        return None


def _job_actions_url(item: dict) -> str | None:
    repo = item.get("repo") or ""
    run_id = item.get("run_id")
    job_id = item.get("job_id")
    if repo and run_id and job_id:
        return web_url(f"https://github.com/{repo}/actions/runs/{run_id}/job/{job_id}")
    if repo and run_id:
        return web_url(f"https://github.com/{repo}/actions/runs/{run_id}")
    return web_url(f"https://github.com/{repo}/actions") if repo else None


def format_queue_snapshot(status_data: dict, state_machine: dict | None, now: float) -> dict:
    """Normalize a queue service `/status` + `/state-machine` response for the browser."""
    workers = []
    for w in status_data.get("workers") or []:
        if not isinstance(w, dict) or not w.get("worker_id"):
            continue
        lanes_list = w.get("lanes")
        if not isinstance(lanes_list, list):
            try:
                lanes_list = json.loads(w.get("lanes_json") or "[]")
            except (ValueError, TypeError):
                lanes_list = []
        workers.append({
            "worker_id": str(w["worker_id"]),
            "online": bool(w.get("online", True)),
            "age_s": w.get("age_s"),
            "lanes": [str(x) for x in lanes_list if isinstance(x, str)],
            "free_cpus": w.get("free_cpus"),
            "max_cpus": w.get("max_cpus"),
            "free_mem_gib": w.get("free_mem_gib"),
            "empty_mem_gib": w.get("empty_mem_gib"),
            "free_disk_gib": w.get("free_disk_gib"),
            "empty_disk_gib": w.get("empty_disk_gib"),
            "load_1m": w.get("load_1m"),
            "max_load": w.get("max_load"),
            "temp_c": w.get("temp_c"),
            "max_temp_c": w.get("max_temp_c"),
            "draining": bool(w.get("draining")),
            "paused_reason": str(w.get("paused_reason") or ""),
            "running_jobs": int(w.get("running_jobs") or 0),
            "max_concurrent": int(w.get("max_concurrent") or 0),
            "primary_local": bool(w.get("primary_local")),
            "boat_day_left": w.get("boat_day_left"),
            "boat_hour_left": w.get("boat_hour_left"),
        })

    def norm_job(j: dict) -> dict:
        queued_at = j.get("queued_at")
        waited = j.get("waited_s")
        if waited is None and isinstance(queued_at, (int, float)):
            waited = max(0, int(now - queued_at))
        return {
            "job_id": j.get("job_id"),
            "repo": str(j.get("repo") or ""),
            "run_id": j.get("run_id"),
            "job_name": str(j.get("job_name") or j.get("job_key") or ""),
            "head_branch": str(j.get("head_branch") or ""),
            "is_release": bool(j.get("is_release")),
            "state": str(j.get("state") or ""),
            "claimed_by": j.get("claimed_by"),
            "claimed_lane": j.get("claimed_lane"),
            "size_name": j.get("size_name"),
            "queued_at": queued_at,
            "claimed_at": j.get("claimed_at"),
            "started_at": j.get("started_at"),
            "finished_at": j.get("finished_at"),
            "waited_s": waited,
            "wait_reason": str(j.get("wait_reason") or ""),
            "attempt": int(j.get("attempt") or 1),
            "url": _job_actions_url(j),
        }

    queued = [norm_job(j) for j in status_data.get("queued") or [] if isinstance(j, dict)]
    running = [norm_job(j) for j in status_data.get("running") or [] if isinstance(j, dict)]
    recent = [norm_job(j) for j in status_data.get("recent") or [] if isinstance(j, dict)][:40]
    sm = state_machine if isinstance(state_machine, dict) and state_machine.get("states") else DEFAULT_STATE_MACHINE
    counts = {str(s): 0 for s in sm.get("states") or []}
    for bucket in (queued, running, recent):
        for item in bucket:
            st = item.get("state")
            if st in counts:
                counts[st] += 1
    return {
        "ok": True,
        "error": None,
        "updated": int(status_data.get("now") or now),
        "workers": workers,
        "running": running,
        "queued": queued,
        "recent": recent,
        "counts": counts,
        "state_machine": sm,
    }


class QueueClient:
    """Server-side reader for a global CI queue's read-only `/status` and `/state-machine` endpoints."""

    def __init__(self, config: dict) -> None:
        self.url_override = str(config.get("url") or "").strip()
        self.url_env = str(config.get("url_env") or "CI_WAKE_URL")
        self.token_env = str(config.get("token_env") or "CI_WAKE_TOKEN")
        self.token_env_file = Path(config["token_env_file"]).expanduser() if config.get("token_env_file") else None
        self.timeout_s = float(config.get("timeout_s") or 4.0)
        self.state_machine: dict | None = None
        self.sm_fetched_at = 0.0
        self.last_good: dict | None = None

    def _credentials(self) -> tuple[str, str]:
        env_vals = read_env_file(self.token_env_file) if self.token_env_file else {}
        raw_url = self.url_override or env_vals.get(self.url_env) or os.environ.get(self.url_env, "")
        token = env_vals.get(self.token_env) or os.environ.get(self.token_env, "")
        return normalize_queue_url(raw_url), token

    def _get_json(self, base: str, path: str, token: str) -> dict:
        headers = {"User-Agent": f"lanes/{VERSION}"}
        if token:
            headers["Authorization"] = f"Bearer {token}"
        req = urllib.request.Request(f"{base}{path}", headers=headers)
        with urllib.request.urlopen(req, timeout=self.timeout_s) as resp:
            data = json.loads(resp.read().decode("utf-8", "replace"))
        if not isinstance(data, dict):
            raise ValueError("queue response was not a JSON object")
        return data

    def fetch(self, now: float) -> dict:
        base, token = self._credentials()
        if not base:
            return {"ok": False, "error": "queue url not configured", "updated": int(now),
                    "workers": [], "running": [], "queued": [], "recent": [], "counts": {}, "state_machine": DEFAULT_STATE_MACHINE}
        if self.state_machine is None or now - self.sm_fetched_at >= STATE_MACHINE_EVERY_S:
            try:
                self.state_machine = self._get_json(base, "/state-machine", token)
                self.sm_fetched_at = now
            except Exception:
                pass
        try:
            data = self._get_json(base, "/status", token)
            snap = format_queue_snapshot(data, self.state_machine, now)
            self.last_good = snap
            return snap
        except Exception as error:
            if self.last_good is not None:
                return {**self.last_good, "ok": False, "error": f"queue unreachable: {type(error).__name__}"}
            return {"ok": False, "error": f"queue unreachable: {type(error).__name__}", "updated": int(now),
                    "workers": [], "running": [], "queued": [], "recent": [], "counts": {},
                    "state_machine": self.state_machine or DEFAULT_STATE_MACHINE}


def is_allowed_media_url(url: str, owners: list[str]) -> str | None:
    """Validate and normalize a GitHub proof media URL against configured owners.

    Rewrites github.com/<owner>/<repo>/(blob|raw)/... to raw.githubusercontent.com/<owner>/<repo>/... so Bearer token
    auth works for private repositories. Returns None for any disallowed host, owner, scheme, or path traversal.
    """
    if not isinstance(url, str):
        return None
    raw = url.strip()
    if not raw:
        return None
    parsed = urllib.parse.urlsplit(raw)
    if parsed.scheme.lower() != "https" or parsed.username or parsed.password:
        return None
    if parsed.port not in (None, 443):
        return None
    host = (parsed.hostname or "").lower()
    path = parsed.path or ""
    segments = [seg for seg in path.split("/") if seg]
    if any(seg in (".", "..") or "%2e" in seg.lower() or "%2f" in seg.lower() for seg in segments):
        return None
    allowed_owners = {o.strip().lower() for o in owners if isinstance(o, str) and o.strip()}
    if host == "github.com":
        if USER_ATTACHMENT_RE.match(path):
            return f"https://github.com{path}"
        if len(segments) >= 5 and segments[2] in ("raw", "blob") and segments[0].lower() in allowed_owners:
            owner, repo = segments[0], segments[1]
            rest = "/".join(segments[3:])
            return f"https://raw.githubusercontent.com/{owner}/{repo}/{rest}"
        return None
    if host == "raw.githubusercontent.com":
        if len(segments) >= 4 and segments[0].lower() in allowed_owners:
            return f"https://raw.githubusercontent.com/{'/'.join(segments)}"
        return None
    return None


def is_allowed_redirect_host(host: str) -> bool:
    h = (host or "").lower()
    return h in GITHUB_ASSET_HOSTS or bool(GITHUB_S3_ASSET_RE.match(h))


def sanitize_media_content_type(content_type: str | None) -> str:
    ct = (content_type or "application/octet-stream").split(";")[0].strip().lower()
    if not ct or any(ct.startswith(bad) for bad in UNSAFE_MEDIA_TYPES):
        return "application/octet-stream"
    return ct


def _clean_markdown_line(text: str) -> str:
    s = re.sub(r"<!--.*?-->", "", text, flags=re.S)
    s = re.sub(r"!\[([^\]]*)\]\([^)]+\)", "", s)
    s = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", s)
    s = re.sub(r"<[^>]+>", " ", s)
    s = re.sub(r"https?://\S+", "", s)
    s = re.sub(r"[`*_~]+", "", s)
    s = re.sub(r"\s+", " ", s).strip(" -*•\t\r\n")
    return s


def extract_pr_summary(body: str) -> tuple[str, str]:
    """Pull a concise plain-English (summary, why) from a PR description."""
    if not isinstance(body, str) or not body.strip():
        return "", ""
    cleaned = re.sub(r"<!--.*?-->", "", body, flags=re.S)
    cleaned = re.sub(r"```.*?```", "", cleaned, flags=re.S)
    sections: dict[str, list[str]] = {"_intro": []}
    current = "_intro"
    for line in cleaned.splitlines():
        heading = re.match(r"^\s*#{1,4}\s+(.+?)\s*$", line)
        if heading:
            current = heading.group(1).strip().lower()
            sections.setdefault(current, [])
        else:
            sections.setdefault(current, []).append(line)

    def pick_text(keys: tuple[str, ...]) -> str:
        for name, lines in sections.items():
            if any(k in name for k in keys):
                items = [_clean_markdown_line(ln) for ln in lines]
                items = [ln for ln in items if ln and not ln.startswith("|") and not set(ln) <= {"-", ":", "|", " "}]
                if items:
                    joined = " · ".join(items[:2])
                    return joined[:237] + "..." if len(joined) > 240 else joined
        return ""

    summary = pick_text(("what changed", "summary", "changes", "overview", "what this does"))
    why = pick_text(("why", "motivation", "problem", "context", "background"))
    if not summary:
        intro = [_clean_markdown_line(ln) for ln in sections.get("_intro", [])]
        intro = [ln for ln in intro if ln and not ln.startswith("|") and not set(ln) <= {"-", ":", "|", " "}]
        if intro:
            joined = " ".join(intro[:2])
            summary = joined[:237] + "..." if len(joined) > 240 else joined
        elif why:
            summary, why = why, ""
    if why and why == summary:
        why = ""
    return summary, why


def _label_from_url(url: str, fallback: str) -> str:
    path = urllib.parse.urlsplit(url).path
    if USER_ATTACHMENT_RE.match(path):
        return fallback
    stem = Path(urllib.parse.unquote(path)).stem
    pretty = re.sub(r"[-_]+", " ", stem).strip()
    return pretty[:48] if pretty else fallback


def _ext_kind(url: str) -> str | None:
    lower = urllib.parse.urlsplit(url).path.lower()
    if lower.endswith(VIDEO_EXTS):
        return "video"
    if lower.endswith(IMAGE_EXTS):
        return "image"
    return None


def extract_pr_media(body: str, comments: list[dict], owners: list[str], probe_kind=None) -> list[dict]:
    """Extract allowlisted proof videos and images from a PR body and its comments."""
    found: dict[str, dict] = {}
    order: list[str] = []

    def add(raw_url: str, hint_kind: str | None, label: str, source: str) -> None:
        cleaned_url = html.unescape(raw_url.strip().rstrip(".,;"))
        norm = is_allowed_media_url(cleaned_url, owners)
        if not norm:
            return
        ext = _ext_kind(norm)
        is_attachment = bool(USER_ATTACHMENT_RE.match(urllib.parse.urlsplit(norm).path))
        if not ext and not is_attachment:
            return
        kind = ext or hint_kind
        if kind is None and is_attachment:
            kind = probe_kind(norm) if probe_kind else "video"
        if kind not in ("video", "image"):
            kind = "video" if is_attachment else "image"
        nice_label = label.strip()[:60] if label and label.strip() else _label_from_url(
            norm, "Proof video" if kind == "video" else "Screenshot"
        )
        if norm in found:
            if found[norm]["kind"] != "video" and kind == "video":
                found[norm]["kind"] = "video"
            if label and label.strip() and found[norm]["label"] in ("Proof video", "Screenshot"):
                found[norm]["label"] = nice_label
            return
        order.append(norm)
        found[norm] = {
            "kind": kind,
            "label": nice_label,
            "src": f"/media?url={urllib.parse.quote(norm, safe='')}",
            "original_url": cleaned_url,
            "source": source,
        }

    chunks = [("body", body or "")] + [("comment", (c.get("body") or "")) for c in comments if isinstance(c, dict)]
    for source, text in chunks:
        if not text:
            continue
        for m in re.finditer(r"<(?:video|source)\b[^>]*?\bsrc=[\"']([^\"']+)[\"']", text, re.I):
            add(m.group(1), "video", "", source)
        for m in re.finditer(r"<img\b([^>]+)>", text, re.I):
            attrs = m.group(1)
            src_m = re.search(r"\bsrc=[\"']([^\"']+)[\"']", attrs, re.I)
            alt_m = re.search(r"\balt=[\"']([^\"']*)[\"']", attrs, re.I)
            if src_m:
                add(src_m.group(1), "image", alt_m.group(1) if alt_m else "", source)
        for m in re.finditer(r"!\[([^\]]*)\]\((https://[^)\s]+)\)", text):
            add(m.group(2), _ext_kind(m.group(2)) or "image", m.group(1), source)
        for m in re.finditer(r"(?<!!)\[([^\]]+)\]\((https://[^)\s]+)\)", text):
            add(m.group(2), _ext_kind(m.group(2)), m.group(1), source)
        for m in re.finditer(r"https://[^\s\"'<>)\]]+", text):
            url = m.group(0)
            if _ext_kind(url) or "/user-attachments/assets/" in url:
                add(url, _ext_kind(url), "", source)

    items = [found[u] for u in order]
    # Videos first so the primary proof player leads the card.
    items.sort(key=lambda item: (0 if item["kind"] == "video" else 1))
    return items[:12]


def summarize_ci_checks(rollup: dict | None) -> dict:
    """Summarize GitHub statusCheckRollup into clean counts and a compact check list."""
    if not isinstance(rollup, dict):
        return {"state": "none", "passed": 0, "running": 0, "failed": 0, "pending": 0, "total": 0, "checks": []}
    contexts = (rollup.get("contexts") or {}).get("nodes") or []
    passed = running = failed = pending = 0
    checks = []
    for node in contexts:
        if not isinstance(node, dict):
            continue
        typename = node.get("__typename")
        if typename == "CheckRun":
            name = str(node.get("name") or "check")
            status = str(node.get("status") or "").upper()
            concl = str(node.get("conclusion") or "").upper()
            url = web_url(node.get("detailsUrl"))
            if status in ("IN_PROGRESS",):
                st = "running"
                running += 1
            elif status in ("QUEUED", "WAITING", "PENDING", "REQUESTED"):
                st = "pending"
                pending += 1
            elif concl in ("SUCCESS", "NEUTRAL", "SKIPPED"):
                st = "passing"
                passed += 1
            elif concl in ("FAILURE", "TIMED_OUT", "ACTION_REQUIRED", "STARTUP_FAILURE", "CANCELLED", "STALE"):
                st = "failing"
                failed += 1
            else:
                st = "pending"
                pending += 1
            checks.append({"name": name, "state": st, "url": url})
        elif typename == "StatusContext":
            name = str(node.get("context") or "status")
            raw_state = str(node.get("state") or "").upper()
            url = web_url(node.get("targetUrl"))
            if raw_state == "SUCCESS":
                st = "passing"
                passed += 1
            elif raw_state in ("FAILURE", "ERROR"):
                st = "failing"
                failed += 1
            else:
                st = "pending"
                pending += 1
            checks.append({"name": name, "state": st, "url": url})
    total = passed + running + failed + pending
    raw_overall = str(rollup.get("state") or "").upper()
    if failed > 0 or raw_overall in ("FAILURE", "ERROR"):
        overall = "failing"
    elif running > 0:
        overall = "running"
    elif pending > 0 or raw_overall == "PENDING":
        overall = "pending"
    elif passed > 0 or raw_overall == "SUCCESS":
        overall = "passing"
    else:
        overall = "none"
    rank = {"failing": 0, "running": 1, "pending": 2, "passing": 3}
    checks.sort(key=lambda c: (rank.get(c["state"], 4), c["name"].lower()))
    return {"state": overall, "passed": passed, "running": running, "failed": failed, "pending": pending,
            "total": total, "checks": checks[:25]}


PR_GRAPHQL_QUERY = """
query($q: String!, $first: Int!, $after: String) {
  search(query: $q, type: ISSUE, first: $first, after: $after) {
    issueCount
    pageInfo { hasNextPage endCursor }
    nodes {
      ... on PullRequest {
        number
        title
        url
        isDraft
        createdAt
        updatedAt
        headRefName
        baseRefName
        additions
        deletions
        changedFiles
        mergeable
        reviewDecision
        body
        author { login }
        repository { nameWithOwner }
        files(first: 8) { nodes { path additions deletions } }
        comments(last: 10) { nodes { body } }
        commits(last: 1) {
          nodes {
            commit {
              statusCheckRollup {
                state
                contexts(first: 40) {
                  nodes {
                    __typename
                    ... on CheckRun { name status conclusion detailsUrl }
                    ... on StatusContext { context state targetUrl }
