#!/usr/bin/env python3
"""lanes: see what every GitHub Actions runner on every one of your machines is doing, from one place.

  lanes agent              print this machine's CI as JSON: the job each runner service (systemd on Linux, launchd on
                           macOS) is running, the jobs that finished in the last 6 hours, load, memory, CPU %, the
                           busiest programs, GPUs, temperatures, and whatever the sources in
                           ~/.config/lanes/agent.toml add.
  lanes hub [CONFIG]       every 5 seconds, run the agent on each machine in CONFIG (default ~/.config/lanes/hub.toml;
                           over SSH for remote ones) and serve the charts page at http://127.0.0.1:8792/ and the data
                           at /status.json. The Lanes menu bar app shows the page. The machine list can come from a
                           command (`machines_command`), re-read every minute.
  lanes demo               serve the charts page with made-up data, to try the app without a fleet.

It only reads: it never starts, stops or changes a runner. Python 3.11+, no packages to install.
"""
from __future__ import annotations

import calendar
import json
import os
import plistlib
import random
import re
import shlex
import socket
import subprocess
import sys
import threading
import time
try:
    import tomllib
except ImportError:      # Python before 3.11: only `lanes demo` works
    tomllib = None
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

VERSION = "0.3.0"
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "lanes"
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "lanes"
PAGE_PLACES = (Path(__file__).resolve().parent / "lanes.html", Path.home() / ".local/share/lanes/lanes.html")
RECENT_S = 6 * 3600              # finished jobs are kept this long
REFRESH_S = 5
LIST_EVERY_S = 60               # how often `machines_command` is re-run
SAMPLE_EVERY_S = 30              # CPU, GPU and heat samples for the sparklines, kept 2 hours
SAMPLES_KEPT = 240
CPU_HOT_C = 90                   # a machine past these is flagged as running hot
GPU_HOT_C = 85
RESULTS = {"succeeded": "success", "success": "success", "failed": "failure", "failure": "failure",
           "canceled": "cancelled", "cancelled": "cancelled"}
LOG_LINE = re.compile(r"(\d{4}-\d\d-\d\d \d\d:\d\d:\d\dZ): (?:Running job: (.+)|Job (.+) completed with result: (\w+))$")


# ---------------------------------------------------------------------------------------------------------------------
# agent: one machine


def read_toml(path: Path) -> dict:
    if tomllib is None:
        sys.exit("lanes needs Python 3.11 or newer (for tomllib); `lanes demo` works on older ones")
    try:
        return tomllib.loads(path.read_text())
    except FileNotFoundError:
        return {}


def stamp(text: str) -> int:
    return calendar.timegm(time.strptime(text, "%Y-%m-%d %H:%M:%SZ"))


def runner_events(lines) -> list:
    """(time, job, result or None) for each 'Running job' and 'completed' line a GitHub runner prints."""
    events = []
    for line in lines:
        match = LOG_LINE.search(line.rstrip())
        if match:
            when, started, finished, result = match.groups()
            events.append((stamp(when), started or finished, None if started else RESULTS.get(result.lower(), result.lower())))
    return events


def finished_jobs(events: list) -> list:
    """(start or None, end, job, result) for each job that finished, paired with its 'Running job' line."""
    started, done = {}, []
    for when, name, result in events:
        if result is None:
            started[name] = when
        else:
            done.append((started.pop(name, None), when, name, result))
    return done


def running_job(events: list) -> tuple:
    """(job name, start) of the job running now, or (None, None) while the runner waits for one."""
    if events and events[-1][2] is None:
        return events[-1][1], events[-1][0]
    return None, None


def run(args: list, timeout: float = 20) -> str:
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def systemd_runners() -> list:
    """(name, folder, log lines) for GitHub runners installed as systemd services (`svc.sh install` on Linux names
    them actions.runner.*). Their output is in the system journal."""
    found = []
    units = [line.split()[0] for line in run(["systemctl", "list-units", "--all", "--plain", "--no-legend",
                                              "actions.runner.*.service"]).splitlines() if line.strip()]
    for unit in units:
        folder = run(["systemctl", "show", "-P", "WorkingDirectory", unit], 10).strip()
        if folder:
            lines = run(["journalctl", "--no-pager", "-o", "cat", "-u", unit,
                         "--since", f"-{RECENT_S // 3600 + 1}h"]).splitlines()
            found.append((unit.removeprefix("actions.runner.").removesuffix(".service"), folder, lines))
    return found


def launchd_runners() -> list:
    """(name, folder, log lines) for GitHub runners installed as launchd services (`svc.sh install` on macOS). Each
    plist names the runner's folder and the file its output goes to."""
    found = []
    plists = [*Path.home().glob("Library/LaunchAgents/actions.runner.*.plist"),
              *Path("/Library/LaunchDaemons").glob("actions.runner.*.plist")]
    for plist in sorted(plists):
        try:
            info = plistlib.loads(plist.read_bytes())
            folder = info["WorkingDirectory"]
        except (OSError, ValueError, KeyError):
            continue
        lines = []
        try:
            with open(info.get("StandardOutPath", ""), "rb") as log:      # the file only grows; its end is enough
                log.seek(0, os.SEEK_END)
                log.seek(max(0, log.tell() - 2**21))
                lines = log.read().decode("utf-8", "replace").splitlines()
        except OSError:
            pass
        found.append((plist.stem.removeprefix("actions.runner."), folder, lines))
    return found


def runner_services(now: float) -> tuple:
    """Jobs from GitHub runners installed as services."""
    found = launchd_runners() if sys.platform == "darwin" else systemd_runners()
    workers = [line for line in run(["ps", "axww", "-o", "command="]).splitlines() if "Runner.Worker" in line]
    jobs, recent = [], []
    for service, folder, lines in found:
        try:
            info = json.loads(Path(folder, ".runner").read_text(encoding="utf-8-sig"))
            url, name = info["gitHubUrl"].rstrip("/"), info.get("agentName", "")
        except (OSError, ValueError, KeyError):
            url, name = None, service
        owner_repo = url.removeprefix("https://github.com/") if url else name
        link = f"{url}/actions" if url and owner_repo.count("/") == 1 else url
        events = runner_events(lines)
        job, since = running_job(events)
        # The log can end on 'Running job' after a crash; a job runs only while the runner has a Worker process.
        if job and any(f"{folder.rstrip('/')}/" in worker for worker in workers):
            jobs.append({"repo": owner_repo, "job": job, "state": "running", "since": since, "label": name, "url": link})
        recent += [{"repo": owner_repo, "job": j, "result": r, "started": s, "finished": e, "label": name, "url": link}
                   for s, e, j, r in finished_jobs(events) if now - e < RECENT_S]
    return jobs, recent


def web_url(url) -> str | None:
    """Links reach a browser, so only http(s) ones pass."""
    return url if isinstance(url, str) and url.startswith(("https://", "http://")) else None


def run_source(command: str) -> dict:
    """A source runs through the shell, as the agent's user, like a line in your own crontab. It gets 30 seconds;
    then its whole process group is stopped, so a child holding its output open can't hang the agent."""
    proc = subprocess.Popen(command, shell=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
                            stdin=subprocess.DEVNULL, start_new_session=True)
    try:
        out, _ = proc.communicate(timeout=30)
    except subprocess.TimeoutExpired:
        os.killpg(proc.pid, 9)
        proc.communicate()
        raise
    extra = json.loads(out)
    if not isinstance(extra, dict):
        raise ValueError("not a JSON object")
    return extra


def mem_free_gib() -> float | None:
    if sys.platform == "darwin":            # free, inactive and speculative pages: what macOS can hand out now
        out = run(["vm_stat"], 5)
        page = re.search(r"page size of (\d+) bytes", out)
        pages = re.findall(r"^Pages (?:free|inactive|speculative):\s+(\d+)", out, re.M)
        return round(sum(map(int, pages)) * int(page.group(1)) / 2**30, 1) if page and pages else None
    try:
        for line in Path("/proc/meminfo").read_text().splitlines():
            if line.startswith("MemAvailable:"):
                return round(int(line.split()[1]) / 2**20, 1)
    except OSError:
        pass
    return None


INTERPRETERS = re.compile(r"^(python[\d.]*|node|bun|deno|ruby|perl|bash|sh|zsh|java)$")


def process_name(argv: list) -> str:
    """`python3.12 suite.py` rather than just `python3.12`: for an interpreter, the script it runs says what it is."""
    if not argv or not argv[0]:
        return "?"
    name = os.path.basename(argv[0])
    if not INTERPRETERS.match(name):
        return name[:48]
    rest = iter(argv[1:6])
    for arg in rest:
        if arg == "-m":                          # python -m module
            return f"{name} -m {next(rest, '')}"[:48]
        if arg in ("-c", "-e"):                  # code on the command line says nothing short
            return f"{name} {arg}"
        if arg and not arg.startswith("-"):
            return f"{name} {os.path.basename(arg)}"[:48]
    return name[:48]


def linux_ticks() -> tuple:
    """(busy, total) CPU ticks for the whole machine, and {pid: (ticks, name)} for every process, from /proc."""
    fields = [int(v) for v in Path("/proc/stat").read_text().split("\n", 1)[0].split()[1:]]
    busy, total = sum(fields) - fields[3] - (fields[4] if len(fields) > 4 else 0), sum(fields)   # idle and iowait
    procs = {}
    for entry in os.scandir("/proc"):
        if not entry.name.isdigit():
            continue
        try:
            stat = Path(entry.path, "stat").read_text()
            rest = stat[stat.rindex(")") + 2:].split()                  # the name in () may hold spaces
            procs[entry.name] = int(rest[11]) + int(rest[12])           # utime + stime
        except (OSError, ValueError, IndexError):
            continue
    return busy, total, procs


def usage_linux() -> tuple:
    """(CPU busy %, busiest processes) since the agent last ran, so each 5-second pass sees the last 5 seconds. With no
    reading from the last minute (the first run), it measures half a second instead."""
    state = STATE_DIR / "cpu.json"
    now = time.time()
    try:
        last = json.loads(state.read_text())
        if now - last["t"] > 60:
            raise ValueError
    except (OSError, ValueError, KeyError, TypeError):
        busy, total, procs = linux_ticks()
        last = {"t": now, "busy": busy, "total": total, "procs": procs}
        time.sleep(0.5)
        now = time.time()
    busy, total, procs = linux_ticks()
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        (STATE_DIR / "cpu.json.new").write_text(json.dumps({"t": now, "busy": busy, "total": total, "procs": procs}))
        (STATE_DIR / "cpu.json.new").replace(state)
    except OSError:
        pass
    cpu = round(100 * (busy - last["busy"]) / max(1, total - last["total"]), 1)
    hz, seconds = os.sysconf("SC_CLK_TCK"), max(0.1, now - last["t"])
    shares = sorted(((ticks - last["procs"].get(pid, ticks)) / hz / seconds * 100, pid) for pid, ticks in procs.items())
    top = []
    for share, pid in reversed(shares[-3:]):
        if share < 10:
            break
        try:
            argv = Path(f"/proc/{pid}/cmdline").read_bytes().decode("utf-8", "replace").split("\0")
        except OSError:
            continue
        top.append({"name": process_name(argv), "pid": int(pid), "cpu": round(share)})
    return cpu, top


def usage_mac() -> tuple:
    """(CPU busy %, busiest processes). macOS's ps already reports each process's recent share of a core."""
    rows = []
    for line in run(["ps", "-A", "-o", "pid=,%cpu="], 10).splitlines():
        try:
            pid, share = line.split()
            rows.append((float(share), int(pid)))
        except ValueError:
            continue
    if not rows:
        return None, []
    rows.sort(reverse=True)
    top = []
    for share, pid in rows[:3]:
        if share < 10:
            break
        # comm is the program's path, which may hold spaces; args adds the script an interpreter runs.
        program = run(["ps", "-p", str(pid), "-o", "comm="], 5).strip()
        args = run(["ps", "-p", str(pid), "-o", "args="], 5).strip()
        argv = [program, *args[len(program):].split()] if program and args.startswith(program) else [program or "?", *args.split()[1:]]
        top.append({"name": process_name(argv), "pid": pid, "cpu": round(share)})
    return round(min(100.0, sum(r[0] for r in rows) / (os.cpu_count() or 1)), 1), top


def read_number(path) -> float | None:
    try:
        return float(Path(path).read_text().strip())
    except (OSError, ValueError):
        return None


def cpu_temp() -> float | None:
    """The CPU package temperature in °C on Linux (Intel coretemp, AMD k10temp), or None where there's no sensor to
    read without root, such as macOS."""
    for hwmon in sorted(Path("/sys/class/hwmon").glob("hwmon*")):
        try:
            name = (hwmon / "name").read_text().strip()
        except OSError:
            continue
        value = read_number(hwmon / "temp1_input") if name in ("coretemp", "k10temp", "zenpower") else None
        if value:
            return round(value / 1000)
    for zone in Path("/sys/class/thermal").glob("thermal_zone*"):
        try:
            if (zone / "type").read_text().strip() == "x86_pkg_temp":
                value = read_number(zone / "temp")
                return round(value / 1000) if value else None
        except OSError:
            continue
    return None


def gpus() -> list:
    """Each GPU's busy %, memory and temperature: NVIDIA's through nvidia-smi, AMD's from sysfs."""
    found = []
    out = run(["nvidia-smi", "--query-gpu=name,utilization.gpu,memory.used,memory.total,temperature.gpu",
               "--format=csv,noheader,nounits"], 8)
    for line in out.splitlines():
        parts = [p.strip() for p in line.split(",")]
        if len(parts) != 5:
            continue
        def num(text):
            try:
                return float(text)
            except ValueError:
                return None       # nvidia-smi prints [N/A] for what a card doesn't report
        busy, used, total, temp = map(num, parts[1:])
        found.append({"name": parts[0].removeprefix("NVIDIA ").removeprefix("GeForce "), "busy": busy,
                      "memUsedGiB": round(used / 1024, 1) if used is not None else None,
                      "memGiB": round(total / 1024, 1) if total is not None else None, "temp": temp})
    for card in sorted(Path("/sys/class/drm").glob("card[0-9]*/device")):
        busy = read_number(card / "gpu_busy_percent")
        if busy is None:
            continue
        temp = next((read_number(t) for t in card.glob("hwmon/hwmon*/temp1_input")), None)
        used, total = read_number(card / "mem_info_vram_used"), read_number(card / "mem_info_vram_total")
        found.append({"name": "AMD GPU", "busy": busy, "temp": round(temp / 1000) if temp else None,
                      "memUsedGiB": round(used / 2**30, 1) if used is not None else None,
                      "memGiB": round(total / 2**30, 1) if total is not None else None})
    return found


def usage() -> dict:
    """What the whole machine is doing, CI or not: CPU %, the busiest processes, GPUs and temperatures."""
    try:
        cpu, top = usage_mac() if sys.platform == "darwin" else usage_linux()
    except OSError:
        cpu, top = None, []
    return {"cpu": cpu, "busiest": top, "cpuTemp": None if sys.platform == "darwin" else cpu_temp(), "gpus": gpus()}


def agent() -> dict:
    """This machine's CI. A source (a command in agent.toml that prints JSON) can add jobs, finished jobs, machine
    fields such as `slots`, and whole machines of its own (`machines`, e.g. cloud runners this machine starts)."""
    now = time.time()
    config = read_toml(CONFIG_DIR / "agent.toml")
    jobs, recent = runner_services(now) if config.get("runner_services", True) else ([], [])
    snap = {"version": VERSION, "time": int(now), "host": socket.gethostname(), "cores": os.cpu_count(),
            "load": round(os.getloadavg()[0], 1), "memFreeGiB": mem_free_gib(), **usage(), "jobs": jobs,
            "recent": recent, "machines": [], "errors": []}
    for command in config.get("sources", []):
        try:
            extra = run_source(command)
        except (subprocess.TimeoutExpired, ValueError, OSError) as error:
            snap["errors"].append(f"source {command!r} failed: {type(error).__name__}")
            continue
        snap["jobs"] += extra.pop("jobs", [])
        snap["recent"] += [r for r in extra.pop("recent", []) if now - r.get("finished", 0) < RECENT_S]
        snap["machines"] += extra.pop("machines", [])
        snap.update(extra)          # anything else describes this machine: slots, note, ...
    return snap


# ---------------------------------------------------------------------------------------------------------------------
# hub: every machine, served as one page


class Hub:
    """The latest picture of every machine, refreshed in the background so a request never waits on SSH."""

    def __init__(self, config: dict) -> None:
        self.machines = config.get("machines") or [{"name": socket.gethostname()}]
        self.machines_command = config.get("machines_command")
        self.listed_at = 0.0
        self.snaps: dict = {}
        # Served until the first pass finishes (a second or two; SSH can take longer).
        self.body = json.dumps({"version": VERSION, "updated": int(time.time()), "running": 0, "starting": 0,
                                "machines": [], "history": [], "recent": [], "samples": []}).encode()
        try:
            self.samples = json.loads((STATE_DIR / "samples.json").read_text())[-SAMPLES_KEPT:]
        except (OSError, ValueError):
            self.samples = []

    def read(self, machine: dict) -> dict:
        if not machine.get("ssh"):
            return agent()
        command = machine.get("command", "~/.local/bin/lanes agent")
        ssh = ["ssh", "-n", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "-o", "ControlMaster=auto",
               "-o", "ControlPath=~/.ssh/lanes-%C", "-o", "ControlPersist=300", *shlex.split(machine.get("ssh_options", "")),
               "--", machine["ssh"], command]
        try:
            out = subprocess.run(ssh, capture_output=True, text=True, timeout=25)
        except subprocess.TimeoutExpired:
            return {"error": "no answer in 25 seconds"}
        except OSError as error:
            return {"error": f"can't run ssh: {error.strerror}"}
        try:
            snap = json.loads(out.stdout)
        except ValueError:
            reason = (out.stderr.strip().splitlines() or ["no output"])[-1][:160]
            return {"error": f"agent failed: {reason}"}
        return snap if isinstance(snap, dict) else {"error": "agent sent something other than a JSON object"}

    def list_machines(self, now: float) -> None:
        """With `machines_command`, the machine list comes from a command (re-run every minute), so a machine added
        to your inventory shows up without editing hub.toml. While it fails or lists nothing, the last list stays."""
        if not self.machines_command or now - self.listed_at < LIST_EVERY_S:
            return
        self.listed_at = now
        try:
            listed = run_source(self.machines_command).get("machines")
        except (subprocess.TimeoutExpired, ValueError, OSError) as error:
            print(f"machines_command failed ({type(error).__name__}); keeping the last machine list", file=sys.stderr, flush=True)
            return
        machines, seen = [], set()
        for m in listed if isinstance(listed, list) else []:
            if not (isinstance(m, dict) and isinstance(m.get("name"), str) and m["name"] and m["name"] not in seen):
                continue
            seen.add(m["name"])
            machines.append({k: v for k, v in m.items() if k in ("name", "ssh", "command", "ssh_options") and isinstance(v, str)})
        if not machines:
            print("machines_command listed no machines; keeping the last machine list", file=sys.stderr, flush=True)
        elif machines != self.machines:
            print(f"machines: {', '.join(m['name'] for m in machines)}", file=sys.stderr, flush=True)
            self.machines = machines

    def refresh(self) -> None:
        now = time.time()
        self.list_machines(now)
        configured = self.machines
        threads = [threading.Thread(target=lambda m=m: self.snaps.__setitem__(m["name"], self.read(m)))
                   for m in configured]
        for thread in threads:
            thread.start()
        for thread in threads:
            thread.join()
        machines, history = [], []
        by_name: dict = {}

        def machine(name: str) -> dict:
            """A configured machine by name, or one a source reports for (such as a cloud provider)."""
            if name not in by_name:
                by_name[name] = {"name": name, "ok": True, "virtual": True, "jobs": []}
                virtuals.append(by_name[name])
            return by_name[name]

        virtuals: list = []
        snaps = [(m, self.snaps.get(m["name"], {"error": "not checked yet"})) for m in configured]
        for m, snap in snaps:
            if "error" in snap:
                by_name[m["name"]] = {"name": m["name"], "ok": False, "error": str(snap["error"]), "jobs": []}
            else:
                entry = {k: v for k, v in snap.items() if k not in ("jobs", "recent", "machines", "errors", "time", "version")}
                by_name[m["name"]] = {**entry, "name": m["name"], "ok": True, "jobs": [], "warnings": snap.get("errors", [])}
            machines.append(by_name[m["name"]])
        for m, snap in snaps:
            if "error" in snap:
                continue
            for job in snap.get("jobs", []):
                target = job.get("machine") or m["name"]
                machine(target)["jobs"].append({**job, "machine": target, "url": web_url(job.get("url"))})
            history += [{**r, "machine": r.get("machine") or m["name"], "url": web_url(r.get("url"))}
                        for r in snap.get("recent", []) if isinstance(r.get("finished"), (int, float))]
            for extra in snap.get("machines", []):
                if isinstance(extra, dict) and extra.get("name"):
                    machine(extra["name"]).update({k: v for k, v in extra.items() if k not in ("jobs", "name", "ok")})
        machines += virtuals
        for machine in machines:
            machine["jobs"].sort(key=lambda j: j.get("since") or 0)
            hot = heat(machine)
            if hot:
                machine["hot"] = hot
        self.sample(now, machines)
        jobs = [j for m in machines for j in m["jobs"]]
        history.sort(key=lambda r: r["finished"])
        self.body = json.dumps({
            "version": VERSION, "updated": int(now),
            "running": sum(1 for j in jobs if j.get("state", "running") == "running"),
            "starting": sum(1 for j in jobs if j.get("state") == "starting"),
            "machines": machines, "history": history, "recent": history[::-1][:12], "samples": self.samples,
        }).encode()

    def sample(self, now: float, machines: list) -> None:
        if self.samples and now - self.samples[-1]["t"] < SAMPLE_EVERY_S:
            return
        point = {"t": int(now)}
        for m in machines:
            gpu = [g["busy"] for g in m.get("gpus") or [] if isinstance(g.get("busy"), (int, float))]
            values = {"load": m.get("load"), "cpu": m.get("cpu"), "gpu": max(gpu) if gpu else None, "temp": m.get("cpuTemp")}
            values = {k: v for k, v in values.items() if isinstance(v, (int, float))}
            if values:
                point[m["name"]] = values
        self.samples = [*self.samples, point][-SAMPLES_KEPT:]
        try:
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            temp = STATE_DIR / "samples.json.new"
            temp.write_text(json.dumps(self.samples))
            temp.replace(STATE_DIR / "samples.json")
        except OSError:
            pass

    def loop(self) -> None:
        while True:
            try:
                self.refresh()
            except Exception as error:      # keep serving the last good picture; the next pass may work
                print(f"refresh failed: {error!r}", file=sys.stderr, flush=True)
            time.sleep(REFRESH_S)


def heat(machine: dict) -> str | None:
    """Why a machine is running hot, such as "CPU 96°C", or None. Heat is what spins the fans up, even when the CPU
    looks mostly idle: a laptop chip can sit at 95°C with two cores busy."""
    parts = []
    temp = machine.get("cpuTemp")
    if isinstance(temp, (int, float)) and temp >= CPU_HOT_C:
        parts.append(f"CPU {temp:.0f}°C")
    for gpu in machine.get("gpus") or []:
        if isinstance(gpu, dict) and isinstance(gpu.get("temp"), (int, float)) and gpu["temp"] >= GPU_HOT_C:
            parts.append(f"GPU {gpu['temp']:.0f}°C")
    return ", ".join(parts) or None


def page() -> bytes:
    for place in PAGE_PLACES:
        if place.exists():
            return place.read_bytes()       # read on every request, so an edited page shows without a restart
    return b"<p>lanes.html is missing: put it next to the lanes script or in ~/.local/share/lanes/</p>"


def serve(source, host: str, port: int, names: list | None = None) -> None:
    # Answer only requests addressed to this server by a name it expects. A web page that points its own domain at
    # 127.0.0.1 (DNS rebinding) sends its domain as Host, and gets nothing.
    allowed = {f"{name}:{port}" for name in ["127.0.0.1", "localhost", "[::1]", host, *(names or [])]}

    class Handler(BaseHTTPRequestHandler):
        def reply(self, code: int, body: bytes = b"", kind: str = "application/json", head: bool = False) -> None:
            self.send_response(code)
            self.send_header("Content-Type", kind)
            self.send_header("Cache-Control", "no-store")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            if not head:
                self.wfile.write(body)

        def do_HEAD(self) -> None:
            self.do_GET(head=True)

        def do_GET(self, head: bool = False) -> None:
            if self.headers.get("Host", "") not in allowed:
                self.reply(403, b"unexpected Host header; add the name you use to `hosts` in hub.toml", "text/plain", head)
                return
            path = self.path.split("?")[0]
            if path == "/":
                self.reply(200, page(), "text/html; charset=utf-8", head)
            elif path == "/status.json":
                self.reply(200, source(), head=head)
            else:
                self.reply(404, head=head)

        def log_message(self, *args) -> None:
            pass

    print(f"lanes {VERSION}: http://{host}:{port}/", flush=True)
    ThreadingHTTPServer((host, port), Handler).serve_forever()


def hub(path: str | None) -> None:
    config = read_toml(Path(path) if path else CONFIG_DIR / "hub.toml")
    lanes = Hub(config)
    threading.Thread(target=lanes.loop, daemon=True).start()
    serve(lambda: lanes.body, config.get("listen", "127.0.0.1"), int(config.get("port", 8792)), config.get("hosts", []))


